JEJAKU_DB_NAME=jejaku
JEJAKU_DB_USER=jejaku
JEJAKU_DB_PASSWORD=changeme

RECEIPT_DB_NAME=jejaku_receipt
RECEIPT_DB_USER=jejaku_receipt
RECEIPT_DB_PASSWORD=changeme

RESEND_API_KEY=re_your_key_here
OTP_FROM_EMAIL=otp@jejaku.my

NEXT_PUBLIC_JEJAKU_URL=https://jejaku.my
NEXT_PUBLIC_RECEIPT_URL=https://jejaku-receipt.jejaku.my

AUTH_SECRET=generate_with_openssl_rand_base64_32
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
DISCORD_CLIENT_ID=your_discord_oauth_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret

# Shared across jejaku and jejaku-receipt so both can read/clear the same
# session cookie. Must be the leading-dot parent domain of both subdomains.
COOKIE_DOMAIN=.jejaku.my

# Used by jejaku-receipt for receipt auto-capture and scan extraction.
DEEPSEEK_API_KEY=sk_your_key_here

# Contact address Let's Encrypt uses for cert-expiry notices — used by
# init-letsencrypt.sh, not the apps themselves.
LETSENCRYPT_EMAIL=you@example.com
